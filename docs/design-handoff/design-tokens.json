{
  "$schema": "https://json.schemastore.org/design-tokens",
  "$description": "PairFit design tokens — single source of truth. Compatible with tailwind.config.ts (PF-1) and src/index.css (PF-1). New tokens are additive; nothing overrides existing values.",
  "$meta": {
    "version": "1.0.0",
    "maintainedBy": "UI Design Agent (b2c4654d-ce3c-4274-8c38-9629cfbce648)",
    "sourceFiles": [
      "tailwind.config.ts",
      "src/index.css",
      "src/store/theme.ts"
    ]
  },
  "color": {
    "$comment": "Brand colors encode the two-partner experience: brand (coral) = partner A · accent (teal) = partner B. Use them together for 'you vs. them' / 'her vs. him' comparisons.",
    "brand": {
      "50": "#FFF1F2",
      "100": "#FFE4E6",
      "200": "#FECDD3",
      "300": "#FDA4AF",
      "400": "#FB7185",
      "500": "#FF6B6B",
      "600": "#E11D48",
      "700": "#BE123C",
      "800": "#9F1239",
      "900": "#881337",
      "rgb": "255 107 107",
      "rgbDark": "251 113 133"
    },
    "accent": {
      "50": "#F0FDFA",
      "100": "#CCFBF1",
      "200": "#99F6E4",
      "300": "#5EEAD4",
      "400": "#2DD4BF",
      "500": "#14B8A6",
      "600": "#0D9488",
      "700": "#0F766E",
      "800": "#115E59",
      "900": "#134E4A",
      "rgb": "20 184 166",
      "rgbDark": "45 212 191"
    },
    "success": {
      "DEFAULT": "#10B981",
      "soft": "#D1FAE5",
      "foreground": "#065F46"
    },
    "warning": {
      "DEFAULT": "#F59E0B",
      "soft": "#FEF3C7",
      "foreground": "#92400E"
    },
    "danger": {
      "DEFAULT": "#EF4444",
      "soft": "#FEE2E2",
      "foreground": "#991B1B"
    },
    "info": {
      "DEFAULT": "#3B82F6",
      "soft": "#DBEAFE",
      "foreground": "#1E40AF"
    },
    "surface": {
      "light": {
        "app": "#FAFAF9",
        "DEFAULT": "#FFFFFF",
        "sunken": "#F5F5F4",
        "elevated": "#FFFFFF"
      },
      "dark": {
        "app": "#0C0A09",
        "DEFAULT": "#1C1917",
        "sunken": "#181615",
        "elevated": "#292524"
      },
      "border": {
        "light": "#E7E5E4",
        "dark": "#292524",
        "strong": {
          "light": "#D6D3D1",
          "dark": "#444040"
        },
        "subtle": {
          "light": "#F5F5F4",
          "dark": "#1C1917"
        }
      }
    },
    "ink": {
      "light": {
        "DEFAULT": "#1C1917",
        "muted": "#57534E",
        "subtle": "#A8A29E"
      },
      "dark": {
        "DEFAULT": "#FAFAF9",
        "muted": "#D6D3D1",
        "subtle": "#A8A29E"
      },
      "onBrand": "#FFFFFF"
    }
  },
  "font": {
    "$comment": "Inter (latin) + Noto Sans SC (CJK). PairFit ships with both; user locale decides which characters are exercised more.",
    "family": {
      "sans": [
        "Inter",
        "-apple-system",
        "BlinkMacSystemFont",
        "PingFang SC",
        "Noto Sans SC",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "display": [
        "Inter",
        "-apple-system",
        "BlinkMacSystemFont",
        "PingFang SC",
        "sans-serif"
      ],
      "mono": [
        "JetBrains Mono",
        "ui-monospace",
        "SFMono-Regular",
        "monospace"
      ]
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "feature": {
      "tabularNums": true,
      "comment": "Tabular numerals for stat UIs — width-stable digits make weight columns line up."
    },
    "size": {
      "$comment": "Type scale — pairs with Tailwind defaults. Display sizes are explicit for marketing/onboarding screens.",
      "xs": ["12px", { "lineHeight": "1.5", "letterSpacing": "0" }],
      "sm": ["14px", { "lineHeight": "1.5", "letterSpacing": "0" }],
      "base": ["16px", { "lineHeight": "1.5", "letterSpacing": "0" }],
      "lg": ["18px", { "lineHeight": "1.5", "letterSpacing": "0" }],
      "xl": ["20px", { "lineHeight": "1.4", "letterSpacing": "-0.005em" }],
      "2xl": ["24px", { "lineHeight": "1.3", "letterSpacing": "-0.01em", "fontWeight": "700" }],
      "3xl": ["30px", { "lineHeight": "1.2", "letterSpacing": "-0.015em", "fontWeight": "700" }],
      "display-lg": ["2.25rem", { "lineHeight": "1.15", "letterSpacing": "-0.01em", "fontWeight": "700" }],
      "display-xl": ["2.75rem", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }],
      "display-2xl": ["3.75rem", { "lineHeight": "1.05", "letterSpacing": "-0.02em", "fontWeight": "700" }]
    }
  },
  "spacing": {
    "$comment": "4-pt baseline grid. Tailwind defaults cover 0..96; we add named safe-area and semantic offsets.",
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "safeBottom": "env(safe-area-inset-bottom, 0px)",
    "safeTop": "env(safe-area-inset-top, 0px)",
    "touchTarget": "44px",
    "comment": "All tappable controls MUST be >= 44px on touch-primary (44pt iOS / 48dp Android)."
  },
  "radius": {
    "none": "0",
    "sm": "6px",
    "DEFAULT": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "full": "9999px"
  },
  "shadow": {
    "xs": "0 1px 2px 0 rgb(0 0 0 / 0.04)",
    "sm": "0 2px 4px -1px rgb(0 0 0 / 0.06), 0 1px 2px -1px rgb(0 0 0 / 0.04)",
    "DEFAULT": "0 4px 12px -2px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.04)",
    "md": "0 8px 24px -4px rgb(0 0 0 / 0.10), 0 4px 8px -4px rgb(0 0 0 / 0.06)",
    "lg": "0 20px 40px -8px rgb(0 0 0 / 0.12), 0 8px 16px -8px rgb(0 0 0 / 0.08)",
    "glow": "0 0 0 6px rgb(255 107 107 / 0.12)",
    "glowAccent": "0 0 0 6px rgb(20 184 166 / 0.14)"
  },
  "motion": {
    "$comment": "Motion is short and decisive. Default 200ms. Anything over 400ms feels laggy on mobile. Respect prefers-reduced-motion (handled globally in src/index.css).",
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "DEFAULT": "200ms",
      "normal": "250ms",
      "slow": "400ms",
      "pageTransition": "280ms"
    },
    "easing": {
      "DEFAULT": "cubic-bezier(0.25, 1, 0.5, 1)",
      "name": "out-quart",
      "inOutQuart": "cubic-bezier(0.76, 0, 0.24, 1)",
      "spring": {
        "soft": { "stiffness": 220, "damping": 24 },
        "snappy": { "stiffness": 320, "damping": 28 },
        "gentle": { "stiffness": 160, "damping": 22 }
      }
    },
    "keyframes": {
      "fadeIn": { "from": { "opacity": 0, "translateY": "4px" }, "to": { "opacity": 1, "translateY": "0" } },
      "slideUp": { "from": { "opacity": 0, "translateY": "12px" }, "to": { "opacity": 1, "translateY": "0" } },
      "shimmer": { "from": { "backgroundPosition": "-200% 0" }, "to": { "backgroundPosition": "200% 0" } },
      "pulseSoft": { "from": { "opacity": 1 }, "to": { "opacity": 0.6 } },
      "pulseRing": {
        "from": { "transform": "scale(1)", "opacity": "0.6" },
        "to": { "transform": "scale(1.6)", "opacity": "0" }
      },
      "celebrationBurst": {
        "comment": "Used after first record save / first partner bind. Add a 1-shot emoji + scale burst.",
        "from": { "transform": "scale(0.8)", "opacity": "0" },
        "to": { "transform": "scale(1.0)", "opacity": "1" }
      }
    }
  },
  "component": {
    "$comment": "Per-component visual specs — used to drive both code and SVG mockups consistently.",
    "button": {
      "primary": { "bg": "brand-500", "fg": "white", "hoverBg": "brand-600", "activeBg": "brand-700" },
      "accent": { "bg": "accent-500", "fg": "white", "hoverBg": "accent-600", "activeBg": "accent-700" },
      "secondary": { "bg": "bg-sunken", "fg": "fg-primary", "border": "border-default" },
      "ghost": { "bg": "transparent", "fg": "fg-primary", "hoverBg": "bg-sunken" },
      "outline": { "bg": "transparent", "fg": "fg-primary", "border": "border-strong" },
      "danger": { "bg": "danger", "fg": "white" },
      "size": {
        "sm": { "h": "32px", "px": "12px", "text": "14px", "radius": "sm" },
        "md": { "h": "40px", "px": "16px", "text": "14px", "radius": "DEFAULT" },
        "lg": { "h": "48px", "px": "20px", "text": "16px", "radius": "DEFAULT" }
      }
    },
    "card": {
      "DEFAULT": { "bg": "bg-surface", "border": "border-default", "radius": "md", "padding": "16px" },
      "raised": { "bg": "bg-elevated", "border": "border-default", "radius": "md", "padding": "16px", "shadow": "sm" }
    },
    "input": {
      "h": "40px",
      "radius": "DEFAULT",
      "padding": "12px",
      "borderColor": "border-default",
      "focusBorderColor": "brand-500",
      "focusRing": "0 0 0 3px rgb(255 107 107 / 0.20)",
      "invalidBorderColor": "danger",
      "invalidRing": "0 0 0 3px rgb(239 68 68 / 0.20)",
      "labelTextSize": "14px"
    },
    "tabBar": {
      "h": "64px",
      "iconSize": "20px",
      "labelSize": "11px",
      "activePillBg": "brand-100 (light) / brand-500/15 (dark)",
      "activeColor": "brand-600 (light) / brand-300 (dark)"
    },
    "topBar": {
      "h": "56px",
      "bg": "bg-surface/85 backdrop-blur-md",
      "border": "border-default bottom"
    }
  },
  "iconography": {
    "$comment": "Use lucide-react (already installed in PF-1). Stroke 1.8 default, 2.4 when active. 20px in lists / 16px in dense rows / 24px on hero.",
    "library": "lucide-react",
    "sizeScale": ["16px", "20px", "24px", "32px"],
    "strokeWidths": { "default": 1.8, "active": 2.4 }
  },
  "imagery": {
    "$comment": "PairFit uses emoji as illustrations (no Lottie in MVP). Library: emoji unicode 14+. Brand-approved set lives in src/components/ui/AvatarPicker.tsx.",
    "emojiCatalog": ["🐶", "🐱", "🦊", "🐼", "🐯", "🦁", "🐸", "🐵", "🐰", "🐨", "🦄", "🐙", "🐳", "🐢", "🍀", "🌸", "🎯", "🎤", "🪙", "📈", "📒", "🔥", "💪", "🥗", "🏃", "🚴"]
  },
  "zIndex": {
    "base": "0",
    "raised": "10",
    "sticky": "30",
    "dropdown": "40",
    "modal": "50",
    "toast": "60"
  },
  "breakpoints": {
    "$comment": "Mobile-first. The app reads as a phone shell on desktop (max-w-5xl). PairFit is primarily a Web PWA that targets phones.",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1440px"
  },
  "container": {
    "maxWidth": "1024px",
    "padding": {
      "mobile": "16px",
      "sm": "24px",
      "lg": "32px"
    }
  },
  "accessibility": {
    "minTouchTarget": "44px",
    "minContrast": {
      "AA-normal": "4.5:1",
      "AA-large": "3:1"
    },
    "focusRing": "2px solid brand-500/60 with 2px offset against bg-app",
    "prefersReducedMotion": "Disable all animation > 0.01ms; scroll-behavior auto."
  },
  "i18n": {
    "$comment": "Two locales only: en (default) + zh (CJK fallback). All UI strings live in src/i18n/locales/{en,zh}.json. No hardcoded strings in JSX.",
    "supportedLocales": ["en", "zh"],
    "defaultLocale": "en",
    "fallbackChain": { "en": "en", "zh": "en" },
    "numberFormat": {
      "weight": {
        "en": { "kg": "0.0 kg", "lb": "0.0 lb" },
        "zh": { "kg": "0.0 公斤", "lb": "0.0 磅" }
      },
      "calories": { "en": "{n} kcal", "zh": "{n} 千卡" },
      "duration": { "en": "{n} min", "zh": "{n} 分钟" }
    }
  }
}